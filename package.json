        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "^1.4.11",
        "@cloudflare/workers-types": "^5.20261023.1",
        "@typescript-eslint/eslint-plugin": "^8.57.1",
        "@typescript-eslint/parser": "^8.57.1",
        "drizzle-kit": "^0.31.10",
        "eslint": "^10.0.3",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.8.1",
        "typescript": "^5.8.2",
        "vitest": "^5.0.5",
        "wrangler": "^4.152.0"
